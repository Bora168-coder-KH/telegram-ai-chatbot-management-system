# Copy this file to ".env" and fill in your values.
# NEVER commit ".env" to GitHub (it is already listed in .gitignore).

# Telegram bot token from @BotFather
BOT_TOKEN=

# polling: run "python -m app.bot.main" (development)
# webhook: Telegram calls WEBHOOK_URL/telegram/webhook on the dashboard (needs public HTTPS)
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=

# SQLite for development (default). For PostgreSQL use:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chatbot
DATABASE_URL=sqlite+aiosqlite:///./chatbot.db

# Secret used to sign admin sessions (change this!)
SECRET_KEY=change-me

# AI provider settings (leave AI_API_KEY empty to run without AI)
# Works with any OpenAI-compatible chat API; the default is OpenRouter.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT=20

# Default language for new users: en or km
DEFAULT_LANGUAGE=en

# Dashboard: local time zone, auto logout, HTTPS-only cookie
TIMEZONE=Asia/Phnom_Penh
SESSION_TIMEOUT_MINUTES=30
SECURE_COOKIES=false

# First admin account for the dashboard (created on first start).
# Leave ADMIN_PASSWORD empty to get a random password printed in the console.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
